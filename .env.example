# Akun Instagram yang digunakan untuk memuat data
IG_USERNAME=username_kamu

# Akun Instagram yang ingin dipantau (kosongkan jika sama dengan IG_USERNAME)
TARGET_ACCOUNT=

# Konfigurasi Telegram Bot
# Dapatkan Token dari Telegram @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
# Dapatkan Chat ID dari Telegram @userinfobot
TELEGRAM_CHAT_ID=123456789

# Pengaturan Notifikasi
NOTIFY_NEW_FOLLOWERS=false
NOTIFY_RENAMED=true

# Interval pengecekan dalam mode --loop (dalam satuan menit, disarankan minimal 180 / 3 jam agar aman)
CHECK_INTERVAL_MINUTES=180
